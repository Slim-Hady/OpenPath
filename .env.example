# Copy to .env and fill in. Never commit .env.

# --- Runtime ---
NODE_ENV=development
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=4000

# --- Supabase (Postgres + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Server-side only. Never expose.
DATABASE_URL=postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres

# --- Queue ---
REDIS_URL=redis://localhost:6379

# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_MAX_TOKENS_PER_USER=20000
AI_TEMPERATURE=0.4
AI_USAGE_LIMIT_USD=5

# --- GitHub ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32-byte base64 key for AES-256-GCM: openssl rand -base64 32
GITHUB_TOKEN_ENC_KEY=

# --- Notifications (optional until Sprint 4) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@example.com

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=info
