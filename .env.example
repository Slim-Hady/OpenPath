# OpenSource-helper — environment template
#
# Copy to .env and fill in locally:
#   cp .env.example .env
#
# .env is gitignored. Never commit it, paste it into chat, or put a value in a
# tracked file. Only NEXT_PUBLIC_* values are allowed to reach the browser.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Server-side URL the Next.js BFF proxy uses to reach the API.
API_URL=http://localhost:4000
# Public origin of the web app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase — Postgres + Auth + Storage
# https://supabase.com/dashboard
# ---------------------------------------------------------------------------
# Base URL only. No /rest/v1 suffix:
#   https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Legacy anon JWT or the new sb_publishable_... key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Legacy service_role JWT or the new sb_secret_... key.
# Server-only. Never rename to NEXT_PUBLIC_*, never use it in apps/web.
SUPABASE_SERVICE_ROLE_KEY=

# Transaction pooler, port 6543. The app runtime uses this.
# Format:
#   postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=

# Session pooler, port 5432. Prisma migrations use this.
# The direct 5432 host is IPv6-only on many networks; the session pooler is IPv4-safe.
# Format:
#   postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Optional. Defaults to:
#   <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Private Storage bucket for CV uploads.
STORAGE_BUCKET=cvs

# ---------------------------------------------------------------------------
# Queue — local Redis (Docker). No Upstash; Redis is not an external service.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# AI — Gemini, server-side only
# https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Use an exact ID returned by:
#   GET https://generativelanguage.googleapis.com/v1beta/models
# gemini-flash-latest is a valid alias when it appears in that list.
GEMINI_MODEL=gemini-flash-latest

# Defaults seeded into ai_settings; the Admin can change them at runtime.
AI_MAX_TOKENS_PER_USER=20000
AI_TEMPERATURE=0.4
AI_USAGE_LIMIT_USD=5

# ---------------------------------------------------------------------------
# GitHub OAuth
# Create the OAuth App at https://github.com/settings/developers
# Authorization callback URL:
#   https://<project-ref>.supabase.co/auth/v1/callback
# Supabase performs the OAuth exchange. The app does not read the client secret
# at runtime; the authoritative copy lives in Supabase's GitHub provider.
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AES-256-GCM key for the stored GitHub provider token.
# Generate with: openssl rand -base64 32
# Must decode to exactly 32 bytes.
GITHUB_TOKEN_ENC_KEY=

# ---------------------------------------------------------------------------
# Email — Resend free tier (100/day, 3,000/month)
# https://resend.com/api-keys
# ---------------------------------------------------------------------------
EMAIL_PROVIDER_API_KEY=
# onboarding@resend.dev works only to your own account email until you verify
# a domain. Use a verified sender for the demo.
EMAIL_FROM=onboarding@resend.dev

# ---------------------------------------------------------------------------
# Optional local Docker services — docker-compose.dev.yml
#   ./scripts/dev-services.sh up
# Supabase still handles Auth and Storage. Only the database and queue move
# to local containers. Use these URLs instead of the Supabase ones above.
# The password below is a local-only default, not a real secret.
# ---------------------------------------------------------------------------
POSTGRES_USER=osh
POSTGRES_PASSWORD=osh_dev_password
POSTGRES_DB=osh

# DATABASE_URL=postgresql://osh:osh_dev_password@localhost:5432/osh?schema=public
# DIRECT_URL=postgresql://osh:osh_dev_password@localhost:5432/osh?schema=public

# Integration tests must never point at Supabase.
TEST_DATABASE_URL=postgresql://osh:osh_dev_password@localhost:5432/osh_test?schema=public
TEST_REDIS_URL=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Not used on purpose
# ---------------------------------------------------------------------------
# SENTRY_DSN        — no Sentry; structured logs only.
# UPSTASH_*         — local Redis only.
# VERCEL_*          — GHCR + docker compose.
# CR_PAT            — GHCR uses GITHUB_TOKEN in Actions; log in locally instead.
# GITHUB_WEBHOOK_*  — polling is the fallback; add only if webhooks are built.
